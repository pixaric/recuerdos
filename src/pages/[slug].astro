---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import { categories, link } from '../data/products';
export function getStaticPaths() { return categories.map(c => ({ params: { slug: c.slug }, props: { c } })); }
const { c } = Astro.props;
const top = c.products[0];
const others = categories.filter(x => x.slug !== c.slug);
---
<Base title={`${c.title}: 5 opciones comparadas`} description={c.intro} sticky>
  <main class="wrap">
    <p class="crumb"><a href="/">Inicio</a> / {c.short}</p>
    <div class="pagehead"><h1>{c.title}</h1><p>{c.intro}</p></div>
    <ProductCard p={top} featured icon={c.icon} />
    <div class="grid">{c.products.slice(1).map((p, i) => <ProductCard p={p} pos={i + 2} />)}</div>
    <div class="guide"><b>Cómo elegir</b>{c.guide}</div>
    <section class="blk" style="padding-top:8px"><h2>Más guías</h2>
      <div class="tiles" style="margin-top:20px">{others.map(o => <a class="tile" href={`/${o.slug}/`}><span class="ic" aria-hidden="true">{o.icon}</span><b>{o.short}</b></a>)}</div>
    </section>
  </main>
  <div class="sticky"><a class="btn" href={link(top.q)} target="_blank" rel="sponsored nofollow noopener">Ver {top.name} en Amazon</a></div>
</Base>
